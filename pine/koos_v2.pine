//@version=6
// KOOS v2  --  Kernel-Ordered Optimal Stopping  (INDICATOR)
//
// Visualises the diagnostics from three papers, no order placement:
//   [1] Derbazi 2026a  -- Thm 3.5: kernel monotone/concave -> >=_lr/>=_lc
//   [2] Derbazi 2026b  -- Prop 2.9: superlevel-set endpoint criterion
//   [3] Gnedin  2026   -- Thm 1: beta(2) hyperbolic boundary 2/(T-t)
//                        Thm 3: discrete uniform cutoffs delta_k
//
// Plots:
//   - >=_st (direct empirical survival comparison) on the price pane as bg
//   - ell(x0) endpoint level (Prop 2.9) in a sub-pane
//   - Gnedin beta-2 threshold curve as an overlay (illustrative)
indicator("KOOS v2 (indicator)", overlay = true)

// ---------------- inputs ----------------
nBase    = input.int  (200, "Baseline N",         minval = 50)
nCurr    = input.int  (50 , "Current  n",         minval = 20)
nBins    = input.int  (21 , "Bins (odd)",         minval = 9)
binHalf  = input.float(2.5, "Half-range (sigmas)",minval = 0.5)
Tbars    = input.int  (40 , "Horizon T (bars)",   minval = 10)
endpMrg  = input.float(0.05,"ell(x0)-1 margin",   minval = 0.0, step = 0.01)

// ---------------- log-returns + adaptive grid ----------------
r   = math.log(close / nz(close[1], close))
mu  = ta.sma  (r, nBase + nCurr)
sig = ta.stdev(r, nBase + nCurr)
binW = (2.0 * binHalf * sig) / nBins

binIdx(x) =>
    raw = math.floor((x - (mu - binHalf * sig)) / binW)
    math.max(0, math.min(nBins - 1, raw))

// ---------------- empirical histograms ----------------
fC = array.new<float>(nBins, 0.0)
fB = array.new<float>(nBins, 0.0)
if not na(sig) and sig > 0
    for j = 0 to nCurr - 1
        b = binIdx(r[j]),  array.set(fC, b, array.get(fC, b) + 1.0)
    for j = nCurr to nCurr + nBase - 1
        b = binIdx(r[j]),  array.set(fB, b, array.get(fB, b) + 1.0)
    for i = 0 to nBins - 1
        array.set(fC, i, (array.get(fC, i) + 1.0) / (nCurr + nBins))
        array.set(fB, i, (array.get(fB, i) + 1.0) / (nBase + nBins))
    // 3-bin smoothing
    fCs = array.new<float>(nBins, 0.0)
    fBs = array.new<float>(nBins, 0.0)
    for i = 0 to nBins - 1
        iL = math.max(0, i - 1)
        iR = math.min(nBins - 1, i + 1)
        array.set(fCs, i, (array.get(fC, iL) + 2.0 * array.get(fC, i) + array.get(fC, iR)) / 4.0)
        array.set(fBs, i, (array.get(fB, iL) + 2.0 * array.get(fB, i) + array.get(fB, iR)) / 4.0)
    sC = array.sum(fCs)
    sB = array.sum(fBs)
    for i = 0 to nBins - 1
        array.set(fC, i, array.get(fCs, i) / sC)
        array.set(fB, i, array.get(fBs, i) / sB)

// ---------------- empirical survival functions ----------------
Sc = array.new<float>(nBins, 0.0)
Sb = array.new<float>(nBins, 0.0)
accC = 0.0,  accB = 0.0
for i = nBins - 1 to 0
    accC += array.get(fC, i)
    accB += array.get(fB, i)
    array.set(Sc, i, accC)
    array.set(Sb, i, accB)

// ---------------- direct empirical >=_st ----------------
stDom_def = true
for i = 0 to nBins - 1
    if array.get(Sc, i) + 1e-9 < array.get(Sb, i)
        stDom_def := false

// ---------------- Paper 1 + Paper 2 diagnostics ----------------
logL = array.new<float>(nBins, 0.0)
ell  = array.new<float>(nBins, 1.0)
for i = 0 to nBins - 1
    v = array.get(fB, i) / array.get(fC, i)
    array.set(ell,  i, v)
    array.set(logL, i, math.log(v))

monoDownLR = true
for i = 1 to nBins - 1
    if array.get(logL, i) > array.get(logL, i - 1) + 1e-9
        monoDownLR := false

concave = true
for i = 0 to nBins - 3
    d2 = array.get(logL, i + 2) - 2.0 * array.get(logL, i + 1) + array.get(logL, i)
    if d2 > 1e-9
        concave := false

leftIdx = 0
for i = 0 to nBins - 1
    if array.get(fB, i) > 1.5 / (nBase + nBins)
        leftIdx := i
        break
ellL       = array.get(ell, leftIdx)
endpointOK = ellL >= 1.0 + endpMrg

inA = true,  intervalOK = true
for i = leftIdx to nBins - 1
    above = array.get(ell, i) >= 1.0
    if inA and not above
        inA := false
    else if (not inA) and above
        intervalOK := false

p29_st = endpointOK and intervalOK

// ---------------- Paper 3: beta(2) reference curve ------------------
// Just plot 2/(T-t) as a function of t for t = 0..T-1 once per session.
// Here we surface the *current* threshold value as a numeric series so the
// user can compare it to their own adverse-excursion measure.
var int tDemo = 0
tDemo := (tDemo + 1) % Tbars
beta2Now = 2.0 / math.max(1, Tbars - tDemo)

// ---------------- visuals ----------------
bgcolor(stDom_def ? color.new(color.teal, 88) : na, title = ">=_st (direct)")
bgcolor(p29_st    ? color.new(color.purple, 92) : na, title = "Prop 2.9 (sufficient)")

plot(ellL,       "ell(x0)",        color = color.purple, display = display.data_window)
plot(1.0 + endpMrg, "endpt level", color = color.gray,   display = display.data_window)
plot(beta2Now,   "beta2(t) demo",  color = color.orange, display = display.data_window)

var table dbg = table.new(position.top_right, 2, 9, border_width = 1)
if barstate.islast
    table.cell(dbg,0,0,">=_st (direct)") , table.cell(dbg,1,0, str.tostring(stDom_def))
    table.cell(dbg,0,1,"ell(x0)")        , table.cell(dbg,1,1, str.tostring(ellL,"#.###"))
    table.cell(dbg,0,2,"endpointOK")     , table.cell(dbg,1,2, str.tostring(endpointOK))
    table.cell(dbg,0,3,"intervalOK")     , table.cell(dbg,1,3, str.tostring(intervalOK))
    table.cell(dbg,0,4,"Prop 2.9 st")    , table.cell(dbg,1,4, str.tostring(p29_st))
    table.cell(dbg,0,5,"K monotone")     , table.cell(dbg,1,5, str.tostring(monoDownLR))
    table.cell(dbg,0,6,"K concave")      , table.cell(dbg,1,6, str.tostring(concave))
    table.cell(dbg,0,7,"beta2 demo")     , table.cell(dbg,1,7, str.tostring(beta2Now,"#.####"))
    table.cell(dbg,0,8,"T")              , table.cell(dbg,1,8, str.tostring(Tbars))
